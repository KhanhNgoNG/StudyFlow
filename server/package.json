{
  "name": "studyflow-server",
  "version": "0.1.0",
  "private": true,
  "description": "StudyFlow backend scaffold",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:migrate": "node --env-file=.env src/database/cli.js migrate",
    "db:seed": "node --env-file=.env src/database/cli.js seed",
    "db:inspect": "node --env-file=.env src/database/cli.js inspect",
    "db:reset": "node --env-file=.env src/database/cli.js reset",
    "test": "node --test"
  }
}
